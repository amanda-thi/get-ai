# ===== Salin ke .env, isi nilai asli. JANGAN commit .env =====
APP_ENV=production
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT=120/minute
TIMEZONE=Asia/Jakarta

# Supabase (service role key HANYA untuk backend, jangan pernah masuk frontend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (build-time, hanya anon key yang boleh di sini)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Dipakai mulai Fase 2/3 (belum aktif di Fase 1) ---
AI_PROVIDER=groq            # groq | openai
GROQ_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true          # STARTTLS pada port 587; false untuk relay internal

# --- Fase 2: sumber tender ---
# SPSE Nasional (spse.inaproc.id) publik, tanpa kunci.
SPSE_BASE_URL=https://spse.inaproc.id
COLLECT_MAX_ROWS=2000       # batas baris per sumber per koleksi
ANALYZE_MAX_BATCH=25        # batas tender dianalisis per panggilan
# INAPROC API Gateway resmi (data.inaproc.id). Butuh token Data Integrator.
INAPROC_API_BASE=https://data.inaproc.id
INAPROC_API_KEY=

# --- Fase 3: Company Leads & Marketing Outreach ---
# Profil perusahaan (satu-satunya sumber fakta untuk AI). Kosong = config/company_profile.yaml.
COMPANY_PROFILE_PATH=
LEAD_ANALYSIS_MAX_BATCH=25  # batas lead dianalisis AI per panggilan
LEAD_FETCH_MAX_PAGES=4      # halaman publik per situs saat mengumpulkan info
OUTREACH_MAX_BATCH=20       # batas email digenerate per panggilan
# Discovery perusahaan berbasis kata kunci. Butuh kunci API pencarian.
# Provider: serper (google.serper.dev) atau tavily (api.tavily.com).
# Kosong = fitur nonaktif dengan pesan jelas; tambah manual & pengumpulan dari situs tetap jalan.
LEAD_SEARCH_PROVIDER=serper # serper | tavily | none
LEAD_SEARCH_API_KEY=
LEAD_SEARCH_BASE_URL=https://google.serper.dev  # tavily: https://api.tavily.com

# --- Fase 4: Automation & Intelligent Scheduling ---
# Scheduler berjalan di dalam proses backend (APScheduler). Jadwal & status disimpan
# di database (tabel automation_configs/jobs), jadi konfigurasi tetap ada setelah restart.
# Set false hanya untuk proses non-web (mis. menjalankan banyak worker) — lock job tetap
# dijaga oleh unique index di database.
SCHEDULER_ENABLED=true
AUTOMATION_MAX_WORKERS=4        # ukuran thread pool scheduler
AUTOMATION_DEFAULT_TIMEOUT=900  # detik; batas waktu kooperatif per job
AUTOMATION_MISFIRE_GRACE=3600   # detik; job terjadwal yang terlewat masih dijalankan
# Kirim juga notifikasi ke email admin (butuh SMTP_*). Default false = notifikasi internal saja.
AUTOMATION_NOTIFY_EMAIL=false
